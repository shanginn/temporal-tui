{
  "version": "@VERSION@",
  "description": "Keyboard-first Temporal dashboard and control plane",
  "homepage": "@REPOSITORY@",
  "license": {
    "identifier": "MIT",
    "url": "@REPOSITORY@/blob/master/LICENSE"
  },
  "architecture": {
    "64bit": {
      "url": "@REPOSITORY@/releases/download/v@VERSION@/@WINDOWS_ARCHIVE@",
      "hash": "@WINDOWS_SHA@",
      "extract_dir": "temporal-tui-v@VERSION@-x86_64-pc-windows-msvc"
    }
  },
  "bin": "temporal-tui.exe",
  "checkver": {
    "github": "@REPOSITORY@"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "@REPOSITORY@/releases/download/v$version/temporal-tui-v$version-x86_64-pc-windows-msvc.zip",
        "extract_dir": "temporal-tui-v$version-x86_64-pc-windows-msvc"
      }
    }
  }
}
